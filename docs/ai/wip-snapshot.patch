+
+    public static HoldingsSnapshotEntity create(
+            long accountSeq,
+            Instant snapshotAt,
+            LocalDate snapshotDate,
+            HoldingsApiResponse.Result result,
+            String rawResponseJson
+    ) {
+        HoldingsSnapshotEntity e = new HoldingsSnapshotEntity();
+        e.accountSeq = accountSeq;
+        e.snapshotAt = snapshotAt;
+        e.snapshotDate = snapshotDate;
+        e.totalPurchaseKrw = result.totalPurchaseAmount().krw();
+        e.totalPurchaseUsd = result.totalPurchaseAmount().usd();
+        e.marketValueKrw = result.marketValue().amount().krw();
+        e.marketValueUsd = result.marketValue().amount().usd();
+        e.profitLossKrw = result.profitLoss().amount().krw();
+        e.profitLossUsd = result.profitLoss().amount().usd();
+        e.dailyPlKrw = result.dailyProfitLoss().amount().krw();
+        e.dailyPlUsd = result.dailyProfitLoss().amount().usd();
+        e.profitLossRate = result.profitLoss().rate();
+        e.dailyPlRate = result.dailyProfitLoss().rate();
+        e.rawResponse = rawResponseJson;
+        return e;
+    }
 }
